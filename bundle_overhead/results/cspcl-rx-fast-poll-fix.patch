+  /* Fast path: repeatedly poll already-live connections with non-blocking
+   * (0ms -- csp_read()'s documented "no hang poll/check" value) reads for
+   * a short budget, before ever blocking on accept(). Senders pool and
+   * reuse their outbound connection, so once one is established almost
+   * every bundle arrives on it rather than on a new connection.
+   *
+   * A single 0ms check is not enough: if the bundle is only microseconds
+   * away from arriving, one failed check falls all the way through to the
+   * ~100ms accept-poll wait below even though the data shows up moments
+   * later -- and since the peer is waiting for this call to return before
+   * it sends (or acks) the next bundle, that one slow round trip re-paces
+   * every subsequent call to land just *before* the next bundle arrives
+   * too, making the ~100ms fallback path self-sustaining instead of a
+   * one-off. Retrying 0ms checks for CSPCL_RX_FAST_POLL_BUDGET_MS breaks
+   * that resonance while still never blocking on a single read: a nonzero
+   * timeout passed to csp_read() on an RDP connection is silently clamped
+   * up to conn_timeout (multiple seconds), so sleeping between repeated
+   * 0ms checks is used instead of a real timeout. */
+  if (live > 0) {
+#ifndef FREERTOS
+    struct timespec fast_deadline;
+    clock_gettime(CLOCK_MONOTONIC, &fast_deadline);
+    fast_deadline.tv_nsec += (long) CSPCL_RX_FAST_POLL_BUDGET_MS * 1000000L;
+    while (fast_deadline.tv_nsec >= 1000000000L) {
+      fast_deadline.tv_sec++;
+      fast_deadline.tv_nsec -= 1000000000L;
+    }
+
+    for (;;) {
+      if (cspcl_rx_poll_once(cspcl, bundle, max_len, len, src_addr, src_port, 0) == CSPCL_OK) {
+        return CSPCL_OK;
+      }
+
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      if (now.tv_sec > fast_deadline.tv_sec ||
+          (now.tv_sec == fast_deadline.tv_sec && now.tv_nsec >= fast_deadline.tv_nsec)) {
+        break;
+      }
+
+      struct timespec sleep_ts = {.tv_sec = 0, .tv_nsec = 1000000L}; /* 1ms */
+      nanosleep(&sleep_ts, NULL);
+    }
+#else
+    if (cspcl_rx_poll_once(cspcl, bundle, max_len, len, src_addr, src_port, 0) == CSPCL_OK) {
+      return CSPCL_OK;
+    }
+#endif
+  }
+
+  live = 0;
+  for (size_t i = 0; i < CSPCL_RX_CONN_TABLE_SIZE; i++) {
+    if (cspcl->rx_conns[i].used) {
+      live++;
+    }
+  }
+
