+/**
+ * @brief One round-robin pass over all live inbound connections
+ *
+ * Tries each live connection in turn, starting from the round-robin
+ * cursor, for up to per_conn_timeout_ms each. Drops any connection that
+ * errors out (not just times out), so the peer can reconnect.
+ *
+ * @return CSPCL_OK if a bundle was received, CSPCL_ERR_TIMEOUT if none of
+ *         the live connections had one ready within the timeout.
+ */
+static cspcl_error_t cspcl_rx_poll_once(cspcl_t *cspcl, uint8_t *bundle, size_t max_len,
+                                        size_t *len, uint8_t *src_addr, uint8_t *src_port,
+                                        uint32_t per_conn_timeout_ms)
+{
+  size_t start = cspcl->rx_tick % CSPCL_RX_CONN_TABLE_SIZE;
+  for (size_t n = 0; n < CSPCL_RX_CONN_TABLE_SIZE; n++) {
+    size_t i = (start + n) % CSPCL_RX_CONN_TABLE_SIZE;
+    cspcl_rx_conn_entry_t *e = &cspcl->rx_conns[i];
+    if (!e->used) {
+      continue;
+    }
+
+    *len = max_len;
+    cspcl_error_t recv_err = cspcl_recv_from_conn_timeout(
+        e->conn, bundle, len, src_addr, src_port, e->src_addr, e->src_port, per_conn_timeout_ms);
+
+    if (recv_err == CSPCL_OK) {
+      e->last_active = ++cspcl->rx_tick;
+      return CSPCL_OK;
+    }
+
+    if (recv_err != CSPCL_ERR_TIMEOUT) {
+      /* Connection is broken - drop it; the peer will reconnect */
+      csp_close(e->conn);
+      e->conn = NULL;
+      e->used = false;
+    }
+  }
+
+  return CSPCL_ERR_TIMEOUT;
+}
