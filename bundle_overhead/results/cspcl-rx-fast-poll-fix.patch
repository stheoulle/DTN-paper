+/** Time budget (ms) for the initial fast-path poll of already-live
+ *  connections in cspcl_recv_bundle(), before falling back to the slower
+ *  accept-poll path above. Implemented as repeated 0ms (non-blocking)
+ *  reads with short sleeps in between, NOT a single read with this value
+ *  as its timeout: csp_read() on an RDP connection silently clamps any
+ *  nonzero timeout up to the connection's conn_timeout (multiple seconds
+ *  by default), so passing a short timeout directly would block far
+ *  longer than intended instead of giving up quickly. */
+#ifndef CSPCL_RX_FAST_POLL_BUDGET_MS
+#define CSPCL_RX_FAST_POLL_BUDGET_MS 20
+#endif
